diff --git a/tests/test_parallel_workers.py b/tests/test_parallel_workers.py
new file mode 100644
index 0000000..9b2c1aa
--- /dev/null
+++ b/tests/test_parallel_workers.py
@@ -0,0 +1,63 @@
+from unittest.mock import patch, MagicMock
+
+from camelot.handlers import PDFHandler
+
+
+def _mock_pool_context():
+    ctx = MagicMock()
+    pool = MagicMock()
+    # Make the context manager work: with ctx.Pool(...) as pool:
+    ctx.Pool.return_value.__enter__.return_value = pool
+    ctx.Pool.return_value.__exit__.return_value = False
+    return ctx
+
+
+def test_workers_limits_cpu_count(monkeypatch):
+    # Simulate 8 cores
+    monkeypatch.setenv("PYTHONHASHSEED", "0")
+    with patch("camelot.handlers.mp.cpu_count", return_value=8), \
+         patch("camelot.handlers.mp.get_context") as get_ctx, \
+         patch.object(PDFHandler, "_parse_page", return_value=[]):
+        ctx = _mock_pool_context()
+        get_ctx.return_value = ctx
+
+        h = PDFHandler("dummy.pdf", pages="1-3")
+        h.parse(parallel=True, workers=64, flavor="lattice", layout_kwargs={})
+
+        assert ctx.Pool.called
+        kwargs = ctx.Pool.call_args.kwargs
+        assert kwargs.get("processes") == 8
+
+
+def test_workers_disable_when_leq_one(monkeypatch):
+    with patch("camelot.handlers.mp.get_context") as get_ctx, \
+         patch.object(PDFHandler, "_parse_page", return_value=[]):
+        h = PDFHandler("dummy.pdf", pages="1-2")
+        h.parse(parallel=True, workers=1, flavor="lattice", layout_kwargs={})
+        assert not get_ctx.called
